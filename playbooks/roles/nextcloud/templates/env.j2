# Postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD={{ nextcloud_postgres_pw }}
POSTGRES_HOST=db

# NextCloud
NEXTCLOUD_TRUSTED_DOMAINS="{{ nextcloud_domain }} {{ nextcloud_trusted_domains }}"
TRUSTED_PROXIES="172.16.0.0/12"
OVERWRITEPROTOCOL="https"

# Redis
REDIS_HOST=redis

# SMTP
SMTP_HOST={{ nextcloud_smtp_host }}
SMTP_SECURE={{ nextcloud_smtp_secure }}
SMTP_PORT={{ nextcloud_smtp_port }}
SMTP_NAME={{ nextcloud_smtp_user }}
SMTP_PASSWORD={{ nextcloud_smtp_password }}
MAIL_FROM_ADDRESS={{ nextcloud_mail_from }}
